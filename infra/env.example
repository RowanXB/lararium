# Copy to infra/.env (never committed) and fill in. Use URL- and shell-safe values,
# e.g. `openssl rand -hex 32`: the passwords go into connection URLs and the backup
# scripts source this file.
POSTGRES_PASSWORD=
FG_OWNER_PASSWORD=
FG_BACKEND_PASSWORD=
# Your Tailscale login (the Tailscale-User-Login value); only this user is let in.
FG_OWNER_LOGIN=
# Where backup.sh writes dumps; a relative path is relative to the repository root.
BACKUP_DIR=backups
# Optional: also push $BACKUP_DIR to a restic repository after each dump.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
