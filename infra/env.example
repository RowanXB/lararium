# Copy to infra/.env (never committed) and fill in. Use URL- and shell-safe values,
# e.g. `openssl rand -hex 32`: the passwords go into connection URLs and the backup
# scripts source this file.
POSTGRES_PASSWORD=
LARARIUM_OWNER_PASSWORD=
LARARIUM_BACKEND_PASSWORD=
# The webhook receiver's database role, which can only insert into the webhook inbox.
# openssl rand -hex 32
LARARIUM_WEBHOOK_IN_PASSWORD=
# Your Tailscale login (the Tailscale-User-Login value); only this user is let in.
LARARIUM_OWNER_LOGIN=
# Encrypts stored credentials: base64 of 32 bytes. Without it they can't be read back.
# openssl rand -base64 32
# Back it up separately from database dumps. If it is lost, every stored credential is
# unreadable: you must re-enter each one and re-authorise each connection.
LARARIUM_MASTER_KEY=
# Where your browser reaches Lararium (the `tailscale serve` URL, no trailing slash). Monzo's
# OAuth redirect URI is this plus /api/v1/connections/oauth/monzo/callback.
LARARIUM_PUBLIC_BASE_URL=
# Webhook ingress; leave all three empty (and COMPOSE_PROFILES unset) to sync by polling only.
# COMPOSE_PROFILES=webhook makes the receiver and the tunnel part of `make up` and `make down`.
COMPOSE_PROFILES=
# The public https URL of the Cloudflare Tunnel hostname, e.g. https://hooks.example.com
LARARIUM_WEBHOOK_BASE_URL=
# The secret in the webhook URL path, at least 32 characters: openssl rand -hex 32
LARARIUM_WEBHOOK_SECRET=
# Token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels); needed by cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional Feishu custom bot for notifications (with signature verification enabled).
LARARIUM_FEISHU_WEBHOOK_URL=
LARARIUM_FEISHU_SECRET=
# Where backup.sh writes dumps; a relative path is relative to the repository root.
BACKUP_DIR=backups
# Optional: also push $BACKUP_DIR to a restic repository after each dump.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
